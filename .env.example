# =============================================================================
# Google Gemini AI — API Key Template
# =============================================================================
#
# SETUP STEPS (do this once after cloning / opening the project in IntelliJ):
#
#   1. Copy this file to '.env' in the project root:
#         Windows:  copy .env.example .env
#         Mac/Linux: cp .env.example .env
#
#   2. Get a free API key at: https://aistudio.google.com/apikeys
#      (Sign in with any Google account — free tier is sufficient for tests)
#
#   3. Replace the placeholder below with your actual key.
#
#   4. IntelliJ will auto-load '.env' via the dotenv-java library already
#      configured in this project.  No further IntelliJ settings are needed.
#
#   ALTERNATIVE (no .env file):
#      In IntelliJ → Run/Debug Configurations → Environment variables, add:
#         GEMINI_API_KEY=your_key_here
#
#   The '.env' file is listed in .gitignore and will NEVER be committed.
#
# USAGE IN TEST CODE:
#
#   import com.framework.utils.GeminiUtils;
#
#   // Ask anything
#   String answer = GeminiUtils.askGemini("What is the best way to write a Selenium locator?");
#
#   // Generate test data on the fly
#   String headline = GeminiUtils.generateTestData("A professional Java developer headline for Naukri profile");
#
#   // Debug a failing test
#   String fix = GeminiUtils.analyzeTestFailure(exception.getMessage(), "User clicks Save Profile button");
#
#   // Get locator suggestions
#   String locator = GeminiUtils.suggestLocator("Profile update save button on naukri.com after login");
#
#   // Generate Gherkin steps
#   String steps = GeminiUtils.generateCucumberSteps("User updates resume headline and saves");
#
# =============================================================================

GEMINI_API_KEY=your_gemini_api_key_here
